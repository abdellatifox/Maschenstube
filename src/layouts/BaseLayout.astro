---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  image = '/images/og-default.svg',
  type = 'website',
  noindex = false,
  publishedTime,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#db6394" />

    <!-- ضبط الوضع (فاتح/داكن) قبل الرسم الأول لمنع الوميض -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          // الوضع الفاتح هو الأساسي؛ الداكن فقط إذا اختاره الزائر يدويًا
          const dark = stored === 'dark';
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          if (dark) document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#170f14');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- الخطوط -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,400;1,500&display=swap"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- HB Agency (Prebid header bidding) — maschenstube, idSito 45177 -->
    <script is:inline src="https://d3u598arehftfk.cloudfront.net/prebid_hb_14842_45177.js" async></script>
    <slot name="head" />
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-blush-600 focus:px-5 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Zum Inhalt springen
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <SearchDialog />

    <!-- ═══════════ HB Agency ═══════════ -->
    <!-- Sticky LeftBanner 300×600 — يوضع بالسكربت أدناه حسب حجم الشاشة -->
    <div id="HB_Footer_Close_hbagency_space_352087" class="hb-rail" data-hb-rail>
      <span class="hb-label">Anzeige</span>
      <div id="HB_CLOSE_hbagency_space_352087"></div>
      <div id="HB_OUTER_hbagency_space_352087">
        <div id="hbagency_space_352087"></div>
      </div>
    </div>

    <!-- Sticky InFooter 728×90 (جوال: 320×50/100) — يظهر فقط بعد تحميل إعلان -->
    <div id="HB_Footer_Close_hbagency_space_352086" class="hb-footer" data-hb-footer>
      <button type="button" class="hb-footer-close" aria-label="Anzeige schließen" data-hb-footer-close>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
      <div id="HB_CLOSE_hbagency_space_352086"></div>
      <div id="HB_OUTER_hbagency_space_352086">
        <div id="hbagency_space_352086"></div>
      </div>
    </div>

    <script is:inline>
      (() => {
        // ── 1) الشريط الجانبي: اختيار أفضل مكان قبل أن يعرض HB الإعلان ──
        const rail = document.querySelector('[data-hb-rail]');
        if (rail) {
          // HB تطلب هذا الإعلان على الهاتف فقط (نفس كشف الجهاز الذي تستعمله HB)
          const ua = navigator.userAgent || '';
          const isMobile =
            (navigator.userAgentData && navigator.userAgentData.mobile === true) ||
            /Android|iPhone|iPod|iPad|Mobile|IEMobile|Opera Mini|BlackBerry/i.test(ua) ||
            (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
          const ps = document.querySelectorAll('.prose-crochet > p');
          if (!isMobile) {
            // الكمبيوتر: لا يُطلب إعلان هنا ← لا نترك مساحة فارغة
            rail.remove();
          } else if (ps.length >= 3) {
            // الجوال: داخل المقال بعد الفقرة الثالثة (300×250)
            ps[2].after(rail);
            rail.classList.add('hb-rail--inline');
          } else {
            // لا مكان مناسب دون تغطية المحتوى ← لا نطلب الإعلان أصلًا
            rail.remove();
          }
        }

        // ── 2) الشريط السفلي: يظهر فقط عند امتلائه، مع زر إغلاق ──
        const foot = document.querySelector('[data-hb-footer]');
        if (foot) {
          let closed = false;
          try { closed = sessionStorage.getItem('hb-footer-closed') === '1'; } catch {}
          if (closed) { foot.remove(); return; }
          const slot = foot.querySelector('#hbagency_space_352086');
          const show = () => {
            // إذا عرض Google إعلان Anchor السفلي بنفسه، لا نُظهر شريطًا ثانيًا
            const anchor = document.querySelector('ins[id^="gpt_unit_"]');
            const filled = !anchor && slot.querySelector('iframe') && slot.offsetHeight > 10;
            foot.classList.toggle('is-filled', !!filled);
            document.body.style.paddingBottom = filled ? foot.offsetHeight + 'px' : '';
          };
          new MutationObserver(show).observe(slot, { childList: true, subtree: true, attributes: true });
          setInterval(show, 1500);
          foot.querySelector('[data-hb-footer-close]').addEventListener('click', () => {
            foot.remove();
            document.body.style.paddingBottom = '';
            try { sessionStorage.setItem('hb-footer-closed', '1'); } catch {}
          });
        }
      })();
    </script>

    <style is:global>
      /* ── HB: الشريط الجانبي ── */
      .hb-label {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-ink-soft, #8a7d84);
        text-align: center;
      }
      .hb-rail { display: none; }
      .hb-rail--inline { display: block; }
      .hb-rail--inline {
        margin: 2rem auto;
        min-height: 250px; /* حجز المساحة لتفادي قفز المحتوى (CLS) */
        text-align: center;
      }
      .hb-rail #hbagency_space_352087 { display: flex; justify-content: center; }

      /* ── HB: الشريط السفلي الملتصق ── */
      .hb-footer {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: 40; /* فوق المحتوى، تحت قائمة الجوال (60) */
        display: flex;
        justify-content: center;
        padding: 4px 0 calc(4px + env(safe-area-inset-bottom));
        background: var(--color-surface, #fff);
        box-shadow: 0 -6px 24px rgb(0 0 0 / 0.12);
        transform: translateY(110%);
        transition: transform 0.35s ease;
      }
      .hb-footer.is-filled { transform: none; }
      .hb-footer #hbagency_space_352086 { display: flex; justify-content: center; max-width: 100vw; overflow: hidden; }
      .hb-footer-close {
        position: absolute;
        top: -26px;
        right: 12px;
        display: grid;
        place-items: center;
        width: 28px;
        height: 26px;
        border-radius: 8px 8px 0 0;
        background: var(--color-surface, #fff);
        color: var(--color-ink, #333);
        box-shadow: 0 -4px 10px rgb(0 0 0 / 0.08);
        cursor: pointer;
      }
    </style>

    <script>
      // ── ظهور تدريجي للعناصر عند التمرير ──
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>

    <style is:global>
      [data-reveal] {
        opacity: 0;
        transform: translateY(22px);
        transition:
          opacity 0.7s var(--ease-out-soft),
          transform 0.7s var(--ease-out-soft);
      }
      [data-reveal].is-visible {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </body>
</html>
