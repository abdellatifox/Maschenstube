---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { categoryMap } from '../data/site';
import { difficultyDots } from '../lib/utils';

interface Props {
  entry: CollectionEntry<'patterns'>;
  size?: 'sm' | 'md' | 'lg';
  index?: number;
  showMeta?: boolean;
}
const { entry, size = 'md', index, showMeta = true } = Astro.props;
const d = entry.data;
const cat = categoryMap[d.category];
const cover = d.cover;

const ratios = { sm: 'aspect-square', md: 'aspect-[4/5]', lg: 'aspect-[3/4]' };
const titles = {
  sm: 'text-[0.95rem] leading-snug',
  md: 'text-lg leading-snug',
  lg: 'text-2xl sm:text-[1.75rem] leading-[1.15]',
};
---

<article class="group" data-reveal>
  <a href={`/patterns/${entry.id}`} class="block">
    <div class={`media-zoom relative ${ratios[size]} overflow-hidden rounded-2xl bg-tint-2`}>
      <img
        src={cover}
        alt={d.title}
        width="1200"
        height="1500"
        loading={index !== undefined && index < 3 ? 'eager' : 'lazy'}
        decoding="async"
        class="size-full object-cover"
      />

      {
        d.featured && (
          <span class="absolute start-3 top-3 rounded-full bg-plum-900/85 px-3 py-1.5 text-[0.6rem] font-bold tracking-[0.18em] text-panel-ink uppercase backdrop-blur-sm">
            Featured
          </span>
        )
      }

      {
        d.pdfKey && (
          <span
            class="absolute end-3 top-3 grid size-8 place-items-center rounded-full bg-surface/90 text-accent-soft backdrop-blur-sm"
            title="Printable PDF available"
          >
            <Icon name="download" size={15} />
          </span>
        )
      }

      <span
        class="absolute inset-x-3 bottom-3 flex translate-y-2 items-center justify-between rounded-full bg-surface/92 px-4 py-2 opacity-0 backdrop-blur-sm transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
      >
        <span class="text-[0.68rem] font-bold tracking-[0.14em] text-ink-strong uppercase">Read pattern</span>
        <Icon name="arrow-right" size={15} class="text-accent" />
      </span>
    </div>

    <div class="mt-4">
      <p class="flex items-center gap-2 text-[0.65rem] font-bold tracking-[0.18em] text-accent uppercase">
        {cat?.title}
        {index !== undefined && <span class="text-muted">/ {String(index + 1).padStart(2, '0')}</span>}
      </p>
      <h3 class={`mt-2 font-display font-bold tracking-tight text-ink-strong transition-colors group-hover:text-accent-soft ${titles[size]}`}>
        {d.title}
      </h3>

      {size === 'lg' && <p class="mt-3 max-w-md text-[0.95rem] leading-relaxed text-ink-soft">{d.excerpt}</p>}

      {
        showMeta && (
          <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.75rem] text-ink-soft">
            <span class="inline-flex items-center gap-1.5">
              <Icon name="hook" size={14} class="text-blush-500" />
              {d.hook}
            </span>
            {d.time && (
              <span class="inline-flex items-center gap-1.5">
                <Icon name="clock" size={14} class="text-blush-500" />
                {d.time}
              </span>
            )}
            <span class="inline-flex items-center gap-1" title={`Difficulty: ${d.difficulty}`}>
              {Array.from({ length: 4 }).map((_, i) => (
                <span
                  class:list={[
                    'size-1.5 rounded-full',
                    i < difficultyDots(d.difficulty) ? 'bg-blush-500' : 'bg-line',
                  ]}
                />
              ))}
              <span class="ms-1 capitalize">{d.difficulty}</span>
            </span>
          </div>
        )
      }
    </div>
  </a>
</article>
