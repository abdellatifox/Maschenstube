---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section class="container-editorial py-20 lg:py-28">
  <div class="grid items-center gap-10 rounded-[2rem] border border-blush-200 bg-blush-50/70 p-8 sm:p-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16" data-reveal>
    <div class="relative mx-auto w-full max-w-xs">
      <div class="media-zoom overflow-hidden rounded-[1.5rem] shadow-lift">
        <img src="/images/author.svg" alt={`${site.author}, the maker behind ${site.name}`} width="900" height="900" loading="lazy" class="size-full object-cover" />
      </div>
      <span class="absolute -bottom-4 -end-4 rounded-full bg-plum-900 px-4 py-2.5 text-[0.6rem] font-bold tracking-[0.18em] text-blush-100 uppercase shadow-soft">
        Since 2019
      </span>
    </div>

    <div>
      <p class="eyebrow">About the author</p>
      <h2 class="mt-4 font-display text-issue font-bold tracking-tight text-plum-900">
        Hi, I'm {site.author}. The maker <span class="accent-italic">behind it all.</span>
      </h2>
      <p class="mt-5 max-w-xl text-[0.98rem] leading-relaxed text-plum-700">
        {site.name} is my little corner of the internet for fellow makers who love modern silhouettes, clean styling and
        patterns that actually work the way they are written. I share everything I make — from chunky bags to delicate
        baby dresses — and I do it for free.
      </p>
      <p class="mt-4 max-w-xl text-[0.98rem] leading-relaxed text-plum-700">
        Every pattern here is tested, written in plain language, and made with the same care I would put into a piece
        for myself. Pull up a chair and stay a while.
      </p>

      <a
        href="/about"
        class="group mt-8 inline-flex items-center gap-2 text-[0.72rem] font-bold tracking-[0.18em] text-plum-900 uppercase transition-colors hover:text-blush-600"
      >
        Read my story
        <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>
