---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section class="container-editorial py-20 lg:py-28">
  <div class="grid items-center gap-10 rounded-[2rem] border border-tint-3 bg-tint/70 p-8 sm:p-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16" data-reveal>
    <div class="relative mx-auto w-full max-w-xs">
      <div class="media-zoom overflow-hidden rounded-[1.5rem] shadow-lift">
        <img src="/images/author.svg" alt={`${site.author}, die Macherin hinter ${site.name}`} width="900" height="900" loading="lazy" class="size-full object-cover" />
      </div>
      <span class="absolute -bottom-4 -end-4 rounded-full bg-panel px-4 py-2.5 text-[0.6rem] font-bold tracking-[0.18em] text-panel-ink uppercase shadow-soft">
        Seit 2019
      </span>
    </div>

    <div>
      <p class="eyebrow">Über die Autorin</p>
      <h2 class="mt-4 font-display text-issue font-bold tracking-tight text-ink-strong">
        Hallo, ich bin {site.author}. Die Macherin <span class="accent-italic">hinter allem.</span>
      </h2>
      <p class="mt-5 max-w-xl text-[0.98rem] leading-relaxed text-ink-soft">
        {site.name} ist meine kleine Ecke im Internet für alle, die moderne Silhouetten, klares Design und Anleitungen
        lieben, die wirklich so funktionieren, wie sie geschrieben sind. Ich teile alles, was ich mache — von dicken
        Taschen bis zu zarten Babykleidchen — und das kostenlos.
      </p>
      <p class="mt-4 max-w-xl text-[0.98rem] leading-relaxed text-ink-soft">
        Jede Anleitung hier ist getestet, in verständlicher Sprache geschrieben und mit derselben Sorgfalt gemacht, die
        ich in ein Stück für mich selbst stecken würde. Zieh dir einen Stuhl heran und bleib eine Weile.
      </p>

      <a
        href="/about"
        class="group mt-8 inline-flex items-center gap-2 text-[0.72rem] font-bold tracking-[0.18em] text-ink-strong uppercase transition-colors hover:text-accent"
      >
        Meine Geschichte lesen
        <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>
