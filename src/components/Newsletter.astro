---
import Icon from './Icon.astro';

interface Props {
  variant?: 'panel' | 'inline';
  source?: string;
  title?: string;
  blurb?: string;
}
const {
  variant = 'panel',
  source = 'footer',
  title = 'Jeden Sonntag eine Anleitung in deinem Postfach.',
  blurb = 'Neue Anleitungen, Garn-Alternativen und ab und zu ein Blick hinter die Kulissen. Kein Spam, Abmeldung mit einem Klick.',
} = Astro.props;

const id = `nl-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class:list={[
    'newsletter',
    variant === 'panel' && 'rounded-3xl bg-panel p-8 text-panel-ink sm:p-11',
    variant === 'inline' && 'rounded-2xl border border-tint-3 bg-tint p-6',
  ]}
  data-newsletter
  data-source={source}
>
  <p class:list={['eyebrow', variant === 'panel' && '!text-panel-accent']}>Die Sonntagsmasche</p>
  <h3
    class:list={[
      'mt-3 font-display font-bold tracking-tight',
      variant === 'panel' ? 'text-2xl text-white sm:text-3xl' : 'text-xl text-ink-strong',
    ]}
  >
    {title}
  </h3>
  <p class:list={['mt-3 max-w-lg text-[0.95rem] leading-relaxed', variant === 'panel' ? 'text-panel-ink-soft/80' : 'text-ink-soft']}>
    {blurb}
  </p>

  <form class="mt-6 flex flex-col gap-3 sm:flex-row" novalidate>
    <label class="sr-only" for={id}>E-Mail-Adresse</label>
    <input
      id={id}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="du@beispiel.de"
      class:list={[
        'min-w-0 flex-1 rounded-full px-5 py-3.5 text-[0.95rem] outline-none transition',
        variant === 'panel'
          ? 'bg-white/10 text-white placeholder:text-panel-ink-soft/50 focus:bg-white/15 focus:ring-2 focus:ring-blush-400'
          : 'border border-line bg-surface text-ink-strong placeholder:text-muted focus:border-blush-400 focus:ring-2 focus:ring-tint-3',
      ]}
    />
    <!-- فخ للبوتات -->
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="absolute -left-[9999px]" aria-hidden="true" />
    <button
      type="submit"
      class:list={[
        'inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-[0.78rem] font-bold tracking-[0.14em] uppercase transition-all hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-60',
        variant === 'panel' ? 'bg-blush-500 text-white hover:bg-blush-400' : 'bg-blush-600 text-white hover:bg-blush-700',
      ]}
    >
      <Icon name="mail" size={16} />
      Abonnieren
    </button>
  </form>

  <p data-msg role="status" aria-live="polite" class="mt-3 min-h-[1.25rem] text-[0.85rem] font-medium"></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-newsletter]').forEach((box) => {
    const form = box.querySelector('form')!;
    const msg = box.querySelector<HTMLElement>('[data-msg]')!;
    const btn = form.querySelector('button')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();

      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        msg.textContent = 'Bitte gib eine gültige E-Mail-Adresse ein.';
        msg.className = 'mt-3 min-h-[1.25rem] text-[0.85rem] font-medium text-blush-400';
        return;
      }

      btn.disabled = true;
      msg.textContent = 'Wird eingetragen…';
      msg.className = 'mt-3 min-h-[1.25rem] text-[0.85rem] font-medium opacity-70';

      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email,
            website: data.get('website') ?? '',
            source: box.dataset.source ?? 'site',
          }),
        });
        const out = await res.json();
        if (res.ok && out.ok) {
          form.reset();
          msg.textContent = out.message ?? 'Du bist dabei! Schau am Sonntag in dein Postfach.';
          msg.className = 'mt-3 min-h-[1.25rem] text-[0.85rem] font-semibold text-panel-accent';
        } else {
          msg.textContent = out.error ?? 'Etwas ist schiefgelaufen. Versuch es gleich noch einmal.';
          msg.className = 'mt-3 min-h-[1.25rem] text-[0.85rem] font-medium text-blush-400';
        }
      } catch {
        msg.textContent = 'Netzwerkfehler — bitte versuch es erneut.';
        msg.className = 'mt-3 min-h-[1.25rem] text-[0.85rem] font-medium text-blush-400';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
