---
import Icon from './Icon.astro';
import Newsletter from './Newsletter.astro';
import { site, categories } from '../data/site';

const year = new Date().getFullYear();
const explore = [
  { label: 'Alle Anleitungen', href: '/patterns' },
  { label: 'Über Mia', href: '/about' },
  { label: 'Kontakt', href: '/contact' },
  { label: 'RSS-Feed', href: '/rss.xml' },
];
const legal = [
  { label: 'Datenschutz', href: '/privacy' },
  { label: 'Nutzungsbedingungen', href: '/terms' },
  { label: 'Haftungsausschluss', href: '/disclaimer' },
];
---

<footer class="mt-24 border-t border-line/70 bg-surface-2">
  <!-- شريط متحرّك -->
  <div class="overflow-hidden border-b border-line/70 bg-tint-2 py-3">
    <div class="flex w-max animate-marquee gap-10 will-change-transform">
      {
        Array.from({ length: 2 }).map(() => (
          <div class="flex shrink-0 gap-10">
            {['Kostenlose Anleitungen', 'Deutsche Häkelbegriffe', 'Doppelt getestet', 'PDFs zum Ausdrucken', 'Mit rosa Garn gemacht', 'Jeden Sonntag neu'].map(
              (t) => (
                <span class="flex items-center gap-10 text-[0.7rem] font-bold tracking-[0.28em] text-accent-soft uppercase">
                  {t}
                  <span class="size-1.5 rounded-full bg-blush-400" />
                </span>
              ),
            )}
          </div>
        ))
      }
    </div>
  </div>

  <div class="container-editorial py-16">
    <Newsletter source="footer" />

    <div class="mt-16 grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink-strong">
          Maschen<span class="accent-italic">stube</span>
        </h2>
        <p class="mt-4 max-w-xs text-[0.92rem] leading-relaxed text-ink-soft">{site.description}</p>
        <ul class="mt-6 flex gap-2">
          {
            site.social.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={s.label}
                  class="grid size-10 place-items-center rounded-full border border-line bg-surface text-ink-soft transition-all hover:-translate-y-0.5 hover:border-blush-400 hover:bg-blush-500 hover:text-white"
                >
                  <Icon name={s.icon as any} size={17} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-labelledby="f-cat">
        <p class="eyebrow" id="f-cat">Kategorien</p>
        <ul class="mt-5 space-y-2.5">
          {
            categories.slice(0, 6).map((c) => (
              <li>
                <a
                  href={`/category/${c.key}`}
                  class="text-[0.9rem] text-ink-soft transition-colors hover:text-accent"
                >
                  {c.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="f-exp">
        <p class="eyebrow" id="f-exp">Entdecken</p>
        <ul class="mt-5 space-y-2.5">
          {
            explore.map((l) => (
              <li>
                <a href={l.href} class="text-[0.9rem] text-ink-soft transition-colors hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="f-leg">
        <p class="eyebrow" id="f-leg">Rechtliches</p>
        <ul class="mt-5 space-y-2.5">
          {
            legal.map((l) => (
              <li>
                <a href={l.href} class="text-[0.9rem] text-ink-soft transition-colors hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-3 border-t border-line/70 pt-7 text-center sm:flex-row sm:text-start"
    >
      <p class="text-[0.7rem] font-semibold tracking-[0.16em] text-ink-soft uppercase">
        © {year} {site.name} — alle Rechte vorbehalten
      </p>
    </div>
  </div>
</footer>
