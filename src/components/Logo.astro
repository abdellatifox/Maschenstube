---
interface Props { class?: string; compact?: boolean }
const { class: cls = '', compact = false } = Astro.props;
---

<a href="/" class={`group inline-flex items-center gap-2.5 ${cls}`} aria-label="Maschenstube — Startseite">
  <span class="relative grid size-11 shrink-0 place-items-center rounded-full bg-tint-2 ring-1 ring-tint-3 transition-colors group-hover:bg-tint-3">
    <svg viewBox="0 0 40 40" class="size-7 text-accent-soft" fill="none" aria-hidden="true">
      <circle cx="20" cy="20" r="12.5" stroke="currentColor" stroke-width="1.8" />
      <path d="M8.5 16.5c7.5 1.9 15.5 1.9 23 0M7.8 23.5c8 2 16.4 2 24.4 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".75" />
      <path d="M16 8c-2.6 8-2.6 16 0 24M24 8c2.6 8 2.6 16 0 24" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".75" />
      <path d="M31 27c3.4 2.4 4.6 5 3.4 7.2-1 1.9-3.3 2.2-4.7.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  </span>
  {
    !compact && (
      <span class="leading-none">
        <span class="block font-display text-[1.05rem] font-bold tracking-tight text-ink-strong">Maschen</span>
        <span class="block accent-italic text-[1.05rem] leading-tight">stube</span>
      </span>
    )
  }
</a>
