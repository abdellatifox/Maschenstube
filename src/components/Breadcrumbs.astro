---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-[0.68rem] font-bold tracking-[0.16em] uppercase">
  <a href="/" class="text-muted transition-colors hover:text-accent">Home</a>
  {
    items.map((item) => (
      <>
        <span class="text-muted/60" aria-hidden="true">/</span>
        {item.href ? (
          <a href={item.href} class="text-muted transition-colors hover:text-accent">
            {item.label}
          </a>
        ) : (
          <span class="text-accent-soft">{item.label}</span>
        )}
      </>
    ))
  }
</nav>
