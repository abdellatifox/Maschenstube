---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, categories } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href.split('#')[0]!);
---

<!-- شريط الإعلان (نصّه يأتي من Cloudflare KV) -->
<div
  id="announce"
  hidden
  class="bg-panel px-4 py-2 text-center text-[0.7rem] font-semibold tracking-[0.18em] text-panel-ink-soft uppercase"
>
  <span id="announce-text"></span>
</div>

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line/60 bg-bg/85 backdrop-blur-md transition-shadow duration-300"
>
  <div class="container-editorial flex h-[74px] items-center justify-between gap-4">
    <Logo />

    <!-- التنقّل — سطح المكتب -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.map((item) =>
          item.label === 'Anleitungen' ? (
            <div class="group relative">
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-1 rounded-full px-4 py-2 text-[0.82rem] font-semibold tracking-wide transition-colors',
                  isActive(item.href) ? 'text-accent-soft' : 'text-ink hover:text-accent',
                ]}
                aria-haspopup="true"
              >
                {item.label}
                <Icon name="chevron-down" size={14} class="transition-transform group-hover:rotate-180" />
              </a>
              <div class="invisible absolute start-0 top-full w-[30rem] translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <div class="grid grid-cols-2 gap-1 rounded-2xl border border-line/70 bg-surface p-3 shadow-lift">
                  {categories.map((c) => (
                    <a
                      href={`/category/${c.key}`}
                      class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-tint"
                    >
                      <span class="font-mono text-[0.68rem] font-bold text-blush-400">{c.no}</span>
                      <span class="text-[0.85rem] font-semibold text-ink">{c.title}</span>
                    </a>
                  ))}
                  <a
                    href="/patterns"
                    class="col-span-2 mt-1 flex items-center justify-between rounded-xl bg-panel px-3 py-2.5 text-[0.78rem] font-bold tracking-[0.14em] text-panel-ink uppercase"
                  >
                    Alle Anleitungen ansehen
                    <Icon name="arrow-right" size={16} />
                  </a>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-4 py-2 text-[0.82rem] font-semibold tracking-wide transition-colors',
                isActive(item.href) ? 'text-accent-soft' : 'text-ink hover:text-accent',
              ]}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />

      <button
        type="button"
        data-search-open
        class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-tint-2 hover:text-accent-soft"
        aria-label="Anleitungen durchsuchen"
      >
        <Icon name="search" size={19} />
      </button>

      <a
        href="/patterns"
        class="hidden rounded-full bg-blush-600 px-5 py-2.5 text-[0.78rem] font-bold tracking-[0.12em] text-white uppercase shadow-soft transition-all hover:-translate-y-0.5 hover:bg-blush-700 hover:shadow-lift sm:inline-block"
      >
        Kostenlose Anleitungen
      </a>

      <button
        type="button"
        id="menu-open"
        class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-tint-2 lg:hidden"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<!-- قائمة الجوال -->
<div id="mobile-menu" hidden class="fixed inset-0 z-[60] lg:hidden">
  <div class="absolute inset-0 bg-plum-900/45 backdrop-blur-sm" data-menu-close></div>
  <div
    id="mobile-panel"
    class="absolute inset-y-0 end-0 flex w-[min(88vw,22rem)] translate-x-full flex-col bg-bg transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between border-b border-line/70 px-5 py-4">
      <Logo compact />
      <button
        type="button"
        data-menu-close
        class="grid size-10 place-items-center rounded-full text-ink hover:bg-tint-2"
        aria-label="Menü schließen"
      >
        <Icon name="close" size={20} />
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-5 py-6" aria-label="Mobile">
      <p class="eyebrow mb-3">Menü</p>
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-xl px-3 py-2.5 text-lg font-semibold text-ink transition-colors hover:bg-tint-2 hover:text-accent-soft"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="eyebrow mt-8 mb-3">Kategorien</p>
      <ul class="space-y-0.5">
        {
          categories.map((c) => (
            <li>
              <a
                href={`/category/${c.key}`}
                class="flex items-center gap-3 rounded-xl px-3 py-2 transition-colors hover:bg-tint"
              >
                <span class="font-mono text-[0.7rem] font-bold text-blush-400">{c.no}</span>
                <span class="text-[0.95rem] font-medium text-ink">{c.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="border-t border-line/70 p-5">
      <ThemeToggle withLabel class="mb-2" />
      <a
        href="/patterns"
        class="block rounded-full bg-blush-600 px-5 py-3 text-center text-[0.8rem] font-bold tracking-[0.12em] text-white uppercase"
      >
        Alle kostenlosen Anleitungen
      </a>
    </div>
  </div>
</div>

<script>
  // ── ظل الهيدر عند التمرير ──
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('shadow-soft', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ── قائمة الجوال ──
  const menu = document.getElementById('mobile-menu');
  const panel = document.getElementById('mobile-panel');
  const openBtn = document.getElementById('menu-open');

  const setMenu = (open: boolean) => {
    if (!menu || !panel) return;
    openBtn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => panel.classList.remove('translate-x-full'));
    } else {
      panel.classList.add('translate-x-full');
      setTimeout(() => (menu.hidden = true), 300);
    }
  };

  openBtn?.addEventListener('click', () => setMenu(true));
  document.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => setMenu(false)));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });

  // ── شريط الإعلان من Cloudflare KV ──
  const KEY = 'announce-dismissed';
  fetch('/api/settings')
    .then((r) => (r.ok ? r.json() : null))
    .then((data: any) => {
      const text = data?.announcement?.trim();
      if (!text || sessionStorage.getItem(KEY) === text) return;
      const bar = document.getElementById('announce');
      const span = document.getElementById('announce-text');
      if (!bar || !span) return;
      span.textContent = text;
      bar.hidden = false;
      bar.addEventListener('click', () => {
        sessionStorage.setItem(KEY, text);
        bar.hidden = true;
      });
    })
    .catch(() => {});
</script>
