---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternMeta from '../../components/PatternMeta.astro';
import PatternActions from '../../components/PatternActions.astro';
import PatternCard from '../../components/PatternCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/Icon.astro';
import { categoryMap, site } from '../../data/site';
import { formatDate } from '../../lib/utils';

export const getStaticPaths = (async () => {
  const patterns = await getCollection('patterns', ({ data }) => !data.draft);
  return patterns.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const cat = categoryMap[d.category];
const cover = d.cover;

const all = await getCollection('patterns', ({ data }) => !data.draft);
const related = all
  .filter((p) => p.id !== entry.id && p.data.category === d.category)
  .slice(0, 3);
const fallback = all.filter((p) => p.id !== entry.id).slice(0, 3);
const suggestions = related.length >= 3 ? related : [...related, ...fallback].slice(0, 3);

const toc = headings.filter((h) => h.depth === 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: d.title,
  description: d.excerpt,
  image: new URL(cover, site.url).href,
  totalTime: d.time,
  datePublished: d.publishDate.toISOString(),
  author: { '@type': 'Person', name: site.author },
  supply: d.materials.map((m) => ({ '@type': 'HowToSupply', name: m })),
  tool: [{ '@type': 'HowToTool', name: `Crochet hook ${d.hook}` }],
  step: toc.map((h, i) => ({ '@type': 'HowToStep', position: i + 1, name: h.text, url: `${site.url}/patterns/${entry.id}#${h.slug}` })),
};
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.excerpt}
  image={cover}
  type="article"
  publishedTime={d.publishDate}
  jsonLd={jsonLd}
>
  <article>
    <!-- الترويسة -->
    <header class="yarn-texture border-b border-line/60">
      <div class="container-editorial py-10 lg:py-14">
        <Breadcrumbs
          items={[{ label: 'Patterns', href: '/patterns' }, { label: cat?.title ?? '', href: `/category/${d.category}` }, { label: d.title }]}
        />

        <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-14">
          <div>
            <p class="eyebrow">{cat?.title} · {formatDate(d.publishDate)}</p>
            <h1 class="mt-4 max-w-2xl font-display text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-ink-strong sm:text-5xl lg:text-[3.4rem]">
              {d.title}
            </h1>
            <p class="mt-6 max-w-xl text-[1.05rem] leading-relaxed text-ink-soft">{d.excerpt}</p>

            <div class="mt-8">
              <PatternActions slug={entry.id} pdfKey={d.pdfKey} pdfGated={d.pdfGated} />
            </div>
          </div>

          <div class="media-zoom overflow-hidden rounded-[1.75rem] bg-tint-2 shadow-lift">
            <img src={cover} alt={d.title} width="1200" height="1500" fetchpriority="high" class="aspect-[4/5] size-full object-cover" />
          </div>
        </div>
      </div>
    </header>

    <!-- المتن -->
    <div class="container-editorial py-14 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
        <div class="min-w-0">
          <!-- فهرس المحتوى -->
          {
            toc.length > 2 && (
              <nav class="mb-10 rounded-2xl border border-line/70 bg-surface p-5 lg:hidden" aria-label="On this page">
                <p class="eyebrow">On this page</p>
                <ul class="mt-3 space-y-1.5">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="text-[0.9rem] text-ink-soft hover:text-accent">
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }

          <div class="prose-crochet max-w-none">
            <Content />
          </div>

          <!-- الوسوم -->
          {
            d.tags.length > 0 && (
              <div class="mt-12 flex flex-wrap items-center gap-2 border-t border-line/70 pt-8">
                <span class="eyebrow me-2">Tagged</span>
                {d.tags.map((t) => (
                  <span class="rounded-full bg-tint-2 px-3.5 py-1.5 text-[0.75rem] font-semibold text-accent-strong">#{t}</span>
                ))}
              </div>
            )
          }

          <div class="mt-10">
            <Newsletter variant="inline" source={`pattern:${entry.id}`} title="Want the next one first?" blurb="One new pattern lands in your inbox every Sunday morning." />
          </div>
        </div>

        <!-- الشريط الجانبي -->
        <aside class="lg:sticky lg:top-28 lg:self-start">
          <PatternMeta data={d} />

          {
            toc.length > 2 && (
              <nav class="mt-6 hidden rounded-2xl border border-line/70 bg-surface p-5 lg:block" aria-label="On this page">
                <p class="eyebrow">On this page</p>
                <ul class="mt-3 space-y-1.5">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="block text-[0.88rem] text-ink-soft transition-colors hover:text-accent">
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }

          <div class="mt-6 rounded-2xl bg-panel p-6 text-panel-ink">
            <p class="eyebrow !text-panel-accent">Save it</p>
            <p class="mt-3 text-[0.9rem] leading-relaxed text-panel-ink-soft/80">
              Pin this pattern so it is waiting for you next time the yarn basket calls.
            </p>
            <a
              href={`https://pinterest.com/pin/create/button/?url=${site.url}/patterns/${entry.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-2 rounded-full bg-blush-500 px-5 py-2.5 text-[0.72rem] font-bold tracking-[0.14em] text-white uppercase transition-colors hover:bg-blush-400"
            >
              <Icon name="pinterest" size={15} />
              Pin it
            </a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <!-- مقترحات -->
  <section class="border-t border-line/70 bg-tint/60 py-16 lg:py-24">
    <div class="container-editorial">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line/70 pb-6">
        <h2 class="font-display text-issue font-bold tracking-tight text-ink-strong">
          Keep <span class="accent-italic">going</span>
        </h2>
        <a
          href={`/category/${d.category}`}
          class="group inline-flex items-center gap-2 text-[0.7rem] font-bold tracking-[0.18em] text-ink uppercase hover:text-accent"
        >
          More {cat?.title}
          <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <div class="mt-9 grid gap-x-6 gap-y-10 sm:grid-cols-3">
        {suggestions.map((p, i) => <PatternCard entry={p} index={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @media print {
    #site-header, footer, aside, .newsletter, [data-actions], #announce, #search-dialog { display: none !important; }
    body { background: white; }
    .prose-crochet { font-size: 11pt; }
    a[href]::after { content: ''; }
  }
</style>
