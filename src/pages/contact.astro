---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const faqs = [
  ['Can I sell what I make from your patterns?', 'Yes — sell as many finished items as you like. Please credit the pattern and never resell the pattern file itself.'],
  ['Can I translate a pattern?', 'Absolutely, with a link back to the original page. Send me the link and I will list it here too.'],
  ['Do you take custom orders?', 'Not at the moment. My hands are full writing the next release.'],
  ['A round is not adding up — help?', 'Send me the pattern name and the round number. I answer every one of these, usually within two days.'],
];
---

<BaseLayout title="Contact" description={`Get in touch with ${site.author} about patterns, corrections and collaborations.`}>
  <section class="yarn-texture border-b border-mauve-300/60">
    <div class="container-editorial py-12 lg:py-16">
      <Breadcrumbs items={[{ label: 'Contact' }]} />
      <h1 class="mt-6 font-display text-hero font-bold tracking-[-0.035em] text-plum-900">
        Say <span class="accent-italic">hello</span>.
      </h1>
      <p class="mt-5 max-w-lg text-[1.02rem] leading-relaxed text-plum-700">
        Pattern questions, corrections, collaborations, or a photo of what you made — all welcome.
      </p>
    </div>
  </section>

  <section class="container-editorial py-14 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <!-- النموذج -->
      <div>
        <form id="contact-form" class="space-y-5" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="eyebrow block">Your name</label>
              <input
                id="name"
                name="name"
                required
                class="mt-2 w-full rounded-2xl border border-mauve-300 bg-white px-4 py-3 text-[0.95rem] text-plum-900 outline-none transition focus:border-blush-400 focus:ring-2 focus:ring-blush-200"
              />
            </div>
            <div>
              <label for="email" class="eyebrow block">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="mt-2 w-full rounded-2xl border border-mauve-300 bg-white px-4 py-3 text-[0.95rem] text-plum-900 outline-none transition focus:border-blush-400 focus:ring-2 focus:ring-blush-200"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="eyebrow block">Subject</label>
            <select
              id="subject"
              name="subject"
              class="mt-2 w-full rounded-2xl border border-mauve-300 bg-white px-4 py-3 text-[0.95rem] text-plum-900 outline-none transition focus:border-blush-400 focus:ring-2 focus:ring-blush-200"
            >
              <option>Pattern question</option>
              <option>Report a correction</option>
              <option>Collaboration</option>
              <option>Something else</option>
            </select>
          </div>

          <div>
            <label for="body" class="eyebrow block">Message</label>
            <textarea
              id="body"
              name="body"
              rows="6"
              required
              class="mt-2 w-full resize-y rounded-2xl border border-mauve-300 bg-white px-4 py-3 text-[0.95rem] text-plum-900 outline-none transition focus:border-blush-400 focus:ring-2 focus:ring-blush-200"
            ></textarea>
          </div>

          <input type="text" name="website" tabindex="-1" autocomplete="off" class="absolute -left-[9999px]" aria-hidden="true" />

          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-full bg-blush-600 px-7 py-3.5 text-[0.78rem] font-bold tracking-[0.14em] text-white uppercase shadow-soft transition-all hover:-translate-y-0.5 hover:bg-blush-700 disabled:opacity-60"
          >
            <Icon name="mail" size={16} />
            Send message
          </button>

          <p id="contact-msg" role="status" aria-live="polite" class="min-h-[1.5rem] text-[0.88rem] font-medium"></p>
        </form>
      </div>

      <!-- الأسئلة الشائعة -->
      <aside>
        <p class="eyebrow">Before you write</p>
        <div class="mt-5 divide-y divide-mauve-300/70 border-y border-mauve-300/70">
          {
            faqs.map(([q, a]) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-plum-900">
                  {q}
                  <span class="grid size-7 shrink-0 place-items-center rounded-full border border-mauve-300 text-blush-600 transition-transform group-open:rotate-180">
                    <Icon name="chevron-down" size={14} />
                  </span>
                </summary>
                <p class="mt-3 text-[0.92rem] leading-relaxed text-plum-700">{a}</p>
              </details>
            ))
          }
        </div>

        <div class="mt-8 rounded-2xl bg-plum-900 p-6 text-blush-100">
          <p class="eyebrow !text-blush-300">Prefer email?</p>
          <a href={`mailto:${site.email}`} class="mt-3 block font-display text-lg font-bold text-white hover:text-blush-300">
            {site.email}
          </a>
          <p class="mt-2 text-[0.86rem] text-blush-200/75">I reply to everything, usually within two days.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const msg = document.getElementById('contact-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    const btn = form.querySelector('button')!;
    const payload = Object.fromEntries(new FormData(form));

    if (!payload.name || !payload.email || !payload.body) {
      msg.textContent = 'Please fill in your name, email and message.';
      msg.className = 'min-h-[1.5rem] text-[0.88rem] font-medium text-blush-600';
      return;
    }

    btn.disabled = true;
    msg.textContent = 'Sending…';
    msg.className = 'min-h-[1.5rem] text-[0.88rem] font-medium opacity-70';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const out = await res.json();
      if (res.ok && out.ok) {
        form.reset();
        msg.textContent = 'Thank you — your message is with me.';
        msg.className = 'min-h-[1.5rem] text-[0.88rem] font-semibold text-blush-700';
      } else {
        msg.textContent = out.error ?? 'Something went wrong. Try again shortly.';
        msg.className = 'min-h-[1.5rem] text-[0.88rem] font-medium text-blush-600';
      }
    } catch {
      msg.textContent = 'Network error — please try again.';
      msg.className = 'min-h-[1.5rem] text-[0.88rem] font-medium text-blush-600';
    } finally {
      btn.disabled = false;
    }
  });
</script>
