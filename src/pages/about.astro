---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const values = [
  { icon: 'check', title: 'Doppelt getestet', body: 'Jede Anleitung wird mindestens zweimal gehäkelt — einmal von mir und einmal von einer Testerin, die sie noch nie gesehen hat.' },
  { icon: 'hook', title: 'Klare Sprache', body: 'Deutsche Häkelbegriffe, kein Abkürzungs-Wirrwarr. Wenn eine Runde knifflig ist, sage ich das und erkläre warum.' },
  { icon: 'download', title: 'Für immer kostenlos', body: 'Die vollständige Anleitung steht auf der Seite. Das druckbare PDF ist ein Extra, niemals eine Bezahlschranke.' },
  { icon: 'heart', title: 'Zum Tragen gemacht', body: 'Moderne Silhouetten und Größen, die über XL hinausgehen — denn wir alle verdienen einen guten Cardigan.' },
];

const timeline = [
  ['2019', 'Ein einziges Granny Square', 'Habe das Häkeln in einem sehr langen Winter aus einem Bibliotheksbuch gelernt.'],
  ['2021', 'Die erste kostenlose Anleitung', 'Habe für eine Freundin eine Markttasche aufgeschrieben. Dreihundert Menschen haben sie in dem Monat gehäkelt.'],
  ['2023', 'Eine richtige Anleitungsbibliothek', 'Alles rund um klare Fotos und ehrliche Größenangaben neu aufgebaut.'],
  ['2026', 'Wo wir heute stehen', 'Über hundert Anleitungen, jeden Sonntag eine neue — immer noch kostenlos.'],
];
---

<BaseLayout title="Über mich" description={`Lerne ${site.author} kennen, die Macherin hinter ${site.name}.`}>
  <section class="yarn-texture border-b border-line/60">
    <div class="container-editorial py-12 lg:py-16">
      <Breadcrumbs items={[{ label: 'About' }]} />
      <div class="mt-8 grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="eyebrow">Die Macherin</p>
          <h1 class="mt-4 font-display text-hero font-bold tracking-[-0.035em] text-ink-strong">
            Hallo, ich bin <span class="accent-italic">{site.author}</span>.
          </h1>
          <p class="mt-6 max-w-xl text-[1.05rem] leading-relaxed text-ink-soft">
            Ich entwerfe Häkelanleitungen für Menschen, die möchten, dass das fertige Stück aussieht, als käme es aus
            dem Laden — und die jede Masche verstehen wollen, die sie dorthin gebracht hat.
          </p>
          <ul class="mt-8 flex gap-2">
            {
              site.social.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                    class="grid size-11 place-items-center rounded-full border border-line bg-surface text-ink-soft transition-all hover:-translate-y-0.5 hover:border-blush-400 hover:bg-blush-500 hover:text-white"
                  >
                    <Icon name={s.icon as any} size={18} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="media-zoom mx-auto w-full max-w-sm overflow-hidden rounded-[1.75rem] shadow-lift">
          <img src="/images/author.svg" alt={site.author} width="900" height="900" class="size-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <section class="container-editorial py-16 lg:py-24">
    <div class="prose-crochet mx-auto max-w-2xl">
      <h2>Wie alles begann</h2>
      <p>
        Ich habe im Winter 2019 zum ersten Mal eine Häkelnadel in die Hand genommen, ohne einen Plan außer dem, meine
        Hände zu beschäftigen. Das erste Granny Square war eine Katastrophe — ehrlich gesagt ein schiefes Fünfeck — und
        ich habe es trotzdem geliebt. Sechs Monate später schrieb ich meine eigenen Anleitungen, weil die, die ich
        fand, entweder die schwierigen Teile ausließen oder sie in Abkürzungen vergruben.
      </p>
      <h2>Worauf es mir ankommt</h2>
      <p>
        Eine Anleitung ist eine Reihe von Anweisungen, die eine Person schreibt und eine fremde Person liest. In dieser
        Lücke steckt die meiste Frustration. Deshalb zähle ich jede Runde, fotografiere die kniffligen Schritte und
        sage dir, wenn etwas falsch aussehen wird, bevor es richtig aussieht.
      </p>
      <blockquote>
        Wenn eine Anleitung dir das Gefühl gibt, dumm zu sein, liegt es an der Anleitung. Nicht an dir.
      </blockquote>
      <h2>Und das Rosa?</h2>
      <p>
        Man fragt mich danach. Die kurze Antwort: Mein erstes gelungenes Projekt war ein altrosa Schal, und das ist
        geblieben. Die längere Antwort: Ein warmes Rosa fotografiert sich wunderbar im Tageslicht und lässt Texturen
        klar erkennen — was enorm wichtig ist, wenn man jemandem zeigen will, wie ein Puff-Stitch aussehen soll.
      </p>
    </div>
  </section>

  <!-- القيم -->
  <section class="border-y border-tint-2 bg-tint/60 py-16 lg:py-24">
    <div class="container-editorial">
      <p class="eyebrow">Das Versprechen</p>
      <h2 class="mt-3 font-display text-issue font-bold tracking-tight text-ink-strong">
        Vier Dinge, die jede Anleitung <span class="accent-italic">richtig macht</span>
      </h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <div class="rounded-2xl border border-tint-3 bg-surface p-6" data-reveal style={`transition-delay:${i * 70}ms`}>
              <span class="grid size-11 place-items-center rounded-full bg-tint-2 text-accent-soft">
                <Icon name={v.icon as any} size={19} />
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-ink-strong">{v.title}</h3>
              <p class="mt-2 text-[0.9rem] leading-relaxed text-ink-soft">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- الخط الزمني -->
  <section class="container-editorial py-16 lg:py-24">
    <p class="eyebrow">Der lange Weg</p>
    <ul class="mt-8 divide-y divide-line/70 border-y border-line/70">
      {
        timeline.map(([year, title, body]) => (
          <li class="grid gap-2 py-6 sm:grid-cols-[7rem_1fr] sm:gap-8" data-reveal>
            <span class="font-mono text-sm font-bold text-blush-500">{year}</span>
            <div>
              <h3 class="font-display text-lg font-bold text-ink-strong">{title}</h3>
              <p class="mt-1 text-[0.93rem] leading-relaxed text-ink-soft">{body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container-editorial pb-24">
    <Newsletter source="about" />
  </section>
</BaseLayout>
