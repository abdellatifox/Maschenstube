---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const values = [
  { icon: 'check', title: 'Tested twice', body: 'Every pattern is worked up at least twice — once by me and once by a tester who has never seen it.' },
  { icon: 'hook', title: 'Plain language', body: 'US terms, no shorthand soup. If a round is fiddly, I say so and explain why.' },
  { icon: 'download', title: 'Free forever', body: 'The full pattern lives on the page. The printable PDF is a convenience, never a paywall.' },
  { icon: 'heart', title: 'Made for wearing', body: 'Modern silhouettes and sizes that go past XL, because we all deserve a good cardigan.' },
];

const timeline = [
  ['2019', 'A single granny square', 'Learned to crochet from a library book during a very long winter.'],
  ['2021', 'The first free pattern', 'Wrote up a market bag for a friend. Three hundred people made it that month.'],
  ['2023', 'A proper pattern library', 'Rebuilt everything around clear photography and honest sizing.'],
  ['2026', 'Where we are now', 'Over a hundred patterns, one new release every Sunday, still free.'],
];
---

<BaseLayout title="About" description={`Meet ${site.author}, the maker behind ${site.name}.`}>
  <section class="yarn-texture border-b border-mauve-300/60">
    <div class="container-editorial py-12 lg:py-16">
      <Breadcrumbs items={[{ label: 'About' }]} />
      <div class="mt-8 grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="eyebrow">The maker</p>
          <h1 class="mt-4 font-display text-hero font-bold tracking-[-0.035em] text-plum-900">
            Hi, I'm <span class="accent-italic">{site.author}</span>.
          </h1>
          <p class="mt-6 max-w-xl text-[1.05rem] leading-relaxed text-plum-700">
            I design crochet patterns for people who want the finished thing to look like it came from a shop — and
            want to understand every stitch that got them there.
          </p>
          <ul class="mt-8 flex gap-2">
            {
              site.social.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                    class="grid size-11 place-items-center rounded-full border border-mauve-300 bg-white text-plum-700 transition-all hover:-translate-y-0.5 hover:border-blush-400 hover:bg-blush-500 hover:text-white"
                  >
                    <Icon name={s.icon as any} size={18} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="media-zoom mx-auto w-full max-w-sm overflow-hidden rounded-[1.75rem] shadow-lift">
          <img src="/images/author.svg" alt={site.author} width="900" height="900" class="size-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <section class="container-editorial py-16 lg:py-24">
    <div class="prose-crochet mx-auto max-w-2xl">
      <h2>How this started</h2>
      <p>
        I picked up a hook in the winter of 2019 with no plan beyond keeping my hands busy. The first granny square was
        a disaster — a wobbly pentagon, honestly — and I loved it anyway. Six months later I was writing my own
        patterns because the ones I found either skipped the hard parts or buried them in shorthand.
      </p>
      <h2>What I care about</h2>
      <p>
        A pattern is a set of instructions written by one person and read by a stranger. That gap is where most
        frustration lives. So I count every round, photograph the fiddly steps, and tell you when something is going to
        look wrong before it looks right.
      </p>
      <blockquote>
        If a pattern makes you feel stupid, the pattern is at fault. Not you.
      </blockquote>
      <h2>And the pink?</h2>
      <p>
        People ask. The short answer is that my first successful project was a dusty rose scarf, and it stuck. The
        longer answer is that a warm pink photographs beautifully in daylight and makes texture read clearly — which
        matters a great deal when you are trying to show someone what a puff stitch should look like.
      </p>
    </div>
  </section>

  <!-- القيم -->
  <section class="border-y border-blush-100 bg-blush-50/60 py-16 lg:py-24">
    <div class="container-editorial">
      <p class="eyebrow">The promise</p>
      <h2 class="mt-3 font-display text-issue font-bold tracking-tight text-plum-900">
        Four things every pattern <span class="accent-italic">gets right</span>
      </h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <div class="rounded-2xl border border-blush-200 bg-white p-6" data-reveal style={`transition-delay:${i * 70}ms`}>
              <span class="grid size-11 place-items-center rounded-full bg-blush-100 text-blush-700">
                <Icon name={v.icon as any} size={19} />
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-plum-900">{v.title}</h3>
              <p class="mt-2 text-[0.9rem] leading-relaxed text-plum-700">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- الخط الزمني -->
  <section class="container-editorial py-16 lg:py-24">
    <p class="eyebrow">The long way round</p>
    <ul class="mt-8 divide-y divide-mauve-300/70 border-y border-mauve-300/70">
      {
        timeline.map(([year, title, body]) => (
          <li class="grid gap-2 py-6 sm:grid-cols-[7rem_1fr] sm:gap-8" data-reveal>
            <span class="font-mono text-sm font-bold text-blush-500">{year}</span>
            <div>
              <h3 class="font-display text-lg font-bold text-plum-900">{title}</h3>
              <p class="mt-1 text-[0.93rem] leading-relaxed text-plum-700">{body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container-editorial pb-24">
    <Newsletter source="about" />
  </section>
</BaseLayout>
