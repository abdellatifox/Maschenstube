---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/site';
---

<BaseLayout title="Page not found" noindex>
  <section class="yarn-texture">
    <div class="container-editorial flex min-h-[62vh] flex-col items-center justify-center py-24 text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-5 font-display text-hero font-bold tracking-[-0.035em] text-plum-900">
        Dropped a <span class="accent-italic">stitch</span>.
      </h1>
      <p class="mt-6 max-w-md text-[1.02rem] leading-relaxed text-plum-700">
        This page has unravelled. Let's get you back to something you can actually make.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href="/patterns"
          class="inline-flex items-center gap-2 rounded-full bg-blush-600 px-7 py-3.5 text-[0.78rem] font-bold tracking-[0.14em] text-white uppercase shadow-soft transition-all hover:-translate-y-0.5 hover:bg-blush-700"
        >
          Browse patterns
          <Icon name="arrow-right" size={16} />
        </a>
        <button
          type="button"
          data-search-open
          class="inline-flex items-center gap-2 rounded-full border border-plum-800/20 px-7 py-3.5 text-[0.78rem] font-bold tracking-[0.14em] text-plum-800 uppercase transition-all hover:-translate-y-0.5 hover:border-blush-400 hover:bg-white"
        >
          <Icon name="search" size={16} />
          Search
        </button>
      </div>

      <ul class="mt-14 flex flex-wrap justify-center gap-2">
        {
          categories.map((c) => (
            <li>
              <a
                href={`/category/${c.key}`}
                class="inline-block rounded-full border border-mauve-300 bg-white px-4 py-2 text-[0.8rem] font-semibold text-plum-800 transition-all hover:border-blush-400 hover:text-blush-700"
              >
                {c.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
