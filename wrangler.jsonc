{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crochet-pattern-theme",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },
  // الدومين المخصص (maschenstube.de / www) مربوط عبر Custom Domains في Cloudflare،
  // وليس عبر routes هنا، لأن التوكن يفتقر صلاحية Zone Workers Routes.

  // ─────────────── D1 : قاعدة البيانات ───────────────
  // wrangler d1 create crochet-db  ← ثم ضع database_id هنا
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crochet-db",
      "database_id": "f7ea7df8-dfce-43d0-9cd5-f22274410f0a",
      "migrations_dir": "db/migrations"
    }
  ],

  // ─────────────── KV : كاش + إعدادات + Rate limit ───────────────
  // wrangler kv namespace create CACHE
  "kv_namespaces": [
    { "binding": "CACHE", "id": "47ed7503d9c646ed8f81b746ebdd0502" },
    { "binding": "SETTINGS", "id": "8a84041613ca4119920cf7af345f8ce9" },
    // جلسات Astro (يطلبها محوّل Cloudflare) — wrangler kv namespace create SESSION
    { "binding": "SESSION", "id": "188ccc5414d44140b357cde1b4a9a462" }
  ],

  // ─────────────── R2 : ملفات PDF والصور ───────────────
  // مؤقتًا معطّل حتى تُضاف صلاحية R2 للتوكن ويُفعّل R2 على الحساب.
  // بعد التفعيل: أنشئ الحاوية `wrangler r2 bucket create crochet-media` ثم أزل التعليق وأعد النشر.
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA",
  //     "bucket_name": "crochet-media"
  //   }
  // ],

  "vars": {
    "SITE_NAME": "Maschenstube",
    "PUBLIC_R2_URL": "" // إن ربطت نطاقًا مخصصًا بالـ R2 ضعه هنا مثال: https://media.example.com
  }
}
